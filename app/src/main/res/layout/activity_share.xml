<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context="ro.dsgmedia.cox.nfcoffee.ShareData">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="@string/csv_data">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/exportData"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:overScrollMode="always"
            android:scrollbars="vertical"
            android:textSize="12sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Input actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pasteData"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="btnPastePressed"
            android:text="@string/paste"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openFile"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:onClick="btnOpenFilePressed"
            android:text="@string/open_file"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyData"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:onClick="btnCopyPressed"
            android:text="@string/copy"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Commit actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeNoSave"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="btnClosePressed"
            android:text="@string/close"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:onClick="btnSavePressed"
            android:text="@string/import_label"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
