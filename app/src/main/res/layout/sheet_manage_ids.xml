<?xml version="1.0" encoding="utf-8"?>
<!--
    Actions that used to live in the com.github.clans FloatingActionMenu.
    Presented as a Material 3 bottom sheet instead.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        android:text="@string/manage_options"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <LinearLayout
        android:id="@+id/sheetDeleteCounters"
        style="@style/SheetRow">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_clear_white_36px"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            style="@style/SheetRowText"
            android:text="@string/delete_counters" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheetExportIds"
        style="@style/SheetRow">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_file_export_white_36px"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            style="@style/SheetRowText"
            android:text="@string/export_ids" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheetImportIds"
        style="@style/SheetRow">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_file_import_white_36px"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            style="@style/SheetRowText"
            android:text="@string/import_ids" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheetScanId"
        style="@style/SheetRow">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_nfc_white_36px"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            style="@style/SheetRowText"
            android:text="@string/scan_id" />

    </LinearLayout>

</LinearLayout>
